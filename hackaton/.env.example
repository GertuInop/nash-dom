# Порт веб-клиента на хосте
WEB_PORT=5173

# URL API бота (куда nginx проксирует /api)
# Варианты:
#   http://host.docker.internal:3080  — бот на этом же ПК (порт 3080)
#   http://nash-dom-bot:3080          — если web подключён к сети compose бота
#   https://ваш-домен.ru              — через Caddy на сервере
API_UPSTREAM=http://host.docker.internal:3080
