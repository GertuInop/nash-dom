# Используется при запуске из корня репозитория:
#   cp .env.example bot/.env
#   docker compose up --build -d
#
# Либо скопируйте в bot/.env и запускайте из bot/

# --- MAX (обязательно для бота в мессенджере) ---
BOT_TOKEN=your_bot_token_here
ADMIN_USER_IDS=123456789
CONSENT_URL=https://example.com/consent.pdf

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=nash_dom
MYSQL_USER=nash_dom
MYSQL_PASSWORD=nash_dom
MYSQL_PORT=3306

# --- HTTP / Caddy ---
API_PORT=3080
API_PUBLISH_PORT=3080
DOMAIN=localhost
ACME_EMAIL=admin@example.com
MINIAPP_URL=https://localhost/
BOT_MODE=auto
WEBHOOK_SECRET=
