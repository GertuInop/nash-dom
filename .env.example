# Единственный .env на весь проект (корень репозитория).
#   cp .env.example .env
#   # заполните BOT_TOKEN, ADMIN_USER_IDS, DOMAIN, MINIAPP_URL
#   bash scripts/docker-up.sh
#
# На сервере УДАЛИТЕ лишние файлы, чтобы не было конфликта:
#   rm -f bot/.env bot/.env.local .env.local
# Docker Compose и бот читают ТОЛЬКО корневой .env

# --- MAX (обязательно) ---
BOT_TOKEN=your_bot_token_here
ADMIN_USER_IDS=123456789

# PDF согласия (пусто = https://<DOMAIN>/server/consent.pdf)
CONSENT_URL=

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=nash_dom
MYSQL_USER=nash_dom
MYSQL_PASSWORD=nash_dom
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# --- HTTP / Caddy ---
API_PORT=3080
API_PUBLISH_PORT=3080

# Прод: ваш домен БЕЗ https://  (пример: nash-dom.example.com)
# Локально: localhost
DOMAIN=localhost

# Локально HTTP. На проде: SITE_ADDRESS=ваш-домен.ru  (Caddy сам сделает HTTPS)
SITE_ADDRESS=http://127.0.0.1, http://localhost
ACME_EMAIL=admin@example.com

# Прод: https://ваш-домен.ru/
MINIAPP_URL=http://127.0.0.1/

# auto = webhook на публичном DOMAIN, иначе polling
# На VPS с доменом лучше: BOT_MODE=auto  (или webhook)
BOT_MODE=auto
WEBHOOK_SECRET=

# Сертификаты Минцифры (локальный запуск вне Docker)
NODE_EXTRA_CA_CERTS=./bot/certs/russian_trusted_ca_bundle.pem

# Если hash Bridge не сходится — оставить 1
MAX_INITDATA_RELAXED=1
