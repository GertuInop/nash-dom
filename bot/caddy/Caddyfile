{
	email {$ACME_EMAIL:admin@example.com}
}

# SITE_ADDRESS:
#   локально:  http://127.0.0.1, http://localhost
#   прод:      ваш-домен.ru   (Caddy сам поднимет HTTPS)
{$SITE_ADDRESS:http://127.0.0.1, http://localhost} {
	encode gzip

	handle /bot* {
		reverse_proxy bot:3080
	}

	handle /server* {
		reverse_proxy bot:3080
	}

	handle {
		reverse_proxy web:80
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}
