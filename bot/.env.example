# Токен бота MAX (обязательно)
BOT_TOKEN=your_bot_token_here

# ID администраторов MAX через запятую
ADMIN_USER_IDS=123456789

# Ссылка на PDF согласия на обработку ПДн (позже замените на свою)
CONSENT_URL=https://example.com/consent.pdf

# Сертификаты Минцифры (нужны для TLS к platform-api2.max.ru)
# В Docker задаётся автоматически. Локально — путь к бандлу:
NODE_EXTRA_CA_CERTS=./certs/russian_trusted_ca_bundle.pem

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nash_dom
MYSQL_PASSWORD=nash_dom
MYSQL_DATABASE=nash_dom
MYSQL_ROOT_PASSWORD=rootpass

# HTTP API для веб-клиента / мини-приложения
API_PORT=3080

# Публичный HTTPS URL мини-приложения (для кнопки в боте и настроек MAX)
# Пример: https://your-host.example.com/
# В кабинете MAX: Чат-боты → ⋮ → Настройки → URL мини-приложения
MINIAPP_URL=
