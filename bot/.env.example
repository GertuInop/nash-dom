# Токен бота MAX (обязательно)
BOT_TOKEN=your_bot_token_here

# ID администраторов MAX через запятую
ADMIN_USER_IDS=123456789

# Ссылка на PDF согласия на обработку ПДн (позже замените на свою)
CONSENT_URL=https://example.com/consent.pdf

# Сертификаты Минцифры (нужны для TLS к platform-api2.max.ru)
# В Docker задаётся автоматически. Локально — путь к бандлу:
NODE_EXTRA_CA_CERTS=./certs/russian_trusted_ca_bundle.pem

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nash_dom
MYSQL_PASSWORD=nash_dom
MYSQL_DATABASE=nash_dom
MYSQL_ROOT_PASSWORD=rootpass

# HTTP API внутри Docker-сети (Caddy проксирует сюда)
API_PORT=3080

# --- Caddy / HTTPS ---
# Домен, на который указывает A/AAAA DNS на этот сервер
# Для локальной проверки без публичного домена: localhost (Caddy выдаст внутренний сертификат)
DOMAIN=localhost

# Email для Let's Encrypt (на реальном домене)
ACME_EMAIL=admin@example.com

# Публичный HTTPS URL мини-приложения (кнопка openApp в боте + кабинет MAX)
# Пример: https://nash-dom.example.com/
# Должен совпадать с DOMAIN (https://$DOMAIN/)
MINIAPP_URL=https://localhost/
